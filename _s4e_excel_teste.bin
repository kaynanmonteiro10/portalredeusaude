            <div class="fieldset04">
                <center>
                    <table cellpadding="1" cellspacing="3">
                        <tr>
                            <td>Empresa*</td>             
                            <td><input name="TXT_Empresa" type="text" maxlength="500" id="TXT_Empresa" pattern="^[\d]+((\d*,\d+)+|\d*)$" oninvalid="setCustomValidity(&#39;Somente números separados por virgulas!&#39;)" onchange="try{setCustomValidity(&#39;&#39;)}catch(e){}" style="width:200px;" /></td>
                            <td align="right">Situação</td>
                            <td><select name="CMB_Situacao" id="CMB_Situacao" style="width: 150px">
		<option value="-1">--Selecione--</option>
		<option value="1">ATIVO</option>
		<option value="24">ATIVO SEM ACESSO APP</option>
		<option value="25">ATIVO SEM FATURA E SEM ACESSO APP</option>
		<option value="4">ATRASADO</option>
		<option value="2">CANCELADO</option>
		<option value="21">CANCELADO POR INADIMPLENCIA</option>
		<option value="20">CANCELAMENTO PROGRAMADO</option>
		<option value="22">IMPORTA&#199;&#195;O</option>
		<option value="6">INADIMPLENTE</option>
		<option value="16">PR&#201; - CADASTRO</option>
		<option value="5">SPC</option>
		<option value="17">SUSPENSO PARA ATIVA&#199;&#195;O</option>
		<option value="3">SUSPENSO PARA CANCELAMENTO</option>

	</select></td>
                            <td align="right">Avançado</td>
                            <td><select name="CMB_SituacaoAvancado" id="CMB_SituacaoAvancado" style="width: 150px">
		<option value="-1">--Selecione--</option>
		<option value="1">GERA COBRAN&#199;A</option>
		<option value="2">ENVIA COBRAN&#199;A</option>
		<option value="3">ATENDIDO CL&#205;NICA</option>
		<option selected="selected" value="4">INCLUI ANS</option>
		<option value="5">ACEITA VENDA</option>

	</select></td>
                            <td>
                                <input id="CHK_Titulares" type="checkbox" name="CHK_Titulares" checked="checked" /><label for="CHK_Titulares">Apenas titulares</label>
                                <br />
                                <input id="CHK_ApenasCarencia" type="checkbox" name="CHK_ApenasCarencia" /><label for="CHK_ApenasCarencia">Apenas com carência</label>
                            </td>
                            <td>&nbsp;</td>
                            <td><input type="submit" name="BTN_Avancar" value="Buscar" onclick="return FF_ChecagemCampos(0,1); return false;" id="BTN_Avancar" /></td>
                        </tr>
                        
                        <div id="PNL_texto_virgula">
		
                        <tr>
                            <td colspan="7">*Código da empresa. Para buscar em mais de uma empresa, separe os códigos por virgula (,).</td>
                        </tr>
                         
	</div>
                          
