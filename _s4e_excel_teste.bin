        <script language="javascript">
            function FF_PG_CRMFecharAlerta() {
                document.getElementById('AlertaCRM').innerHTML = '';
            }
            function FF_PG_CRMAbrir(id, chaId) {
                if (typeof(chaId) != "undefined") {
                    FF_ModalIframe('/SYS/CRM/CRMChamado.aspx?ID=' + chaId + '&AcaoFechar=FecharModal&Alerta=1', 750, 0, 'auto', true, 'mask1', 'CRM');
                }
                else {
                    frames['IAuxiliar'].location.href='/SYS/CRM/CRMAlertaRedirect.aspx?id=' + id;
                }
                FF_PG_CRMFecharAlerta();
            }
            function FF_PG_ProcessoAbrir(id) {
                frames['IAuxiliar'].location.href='/SYS/Consultas/ThreadSistemaRedirect.aspx?id=' + id;
            }

            
        </script>

